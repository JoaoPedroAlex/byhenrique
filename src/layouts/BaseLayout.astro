---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
  title = "ByHenrique",
  description = "Chef privado, menus personalizados, catering e eventos privados.",
  lang = "pt",
  alternateEn,
  alternatePt,
} = Astro.props;

const siteUrl = "https://byhenrique.pt";
const baseUrl = Astro.site ?? siteUrl;

const canonicalUrl = new URL(Astro.url.pathname, baseUrl).href;

const alternateEnUrl = alternateEn
  ? new URL(alternateEn, baseUrl).href
  : null;

const alternatePtUrl = alternatePt
  ? new URL(alternatePt, baseUrl).href
  : null;

const ogImage = `${siteUrl}/og-image.png`;
---

<!doctype html>
<html lang={lang === "en" ? "en" : "pt-PT"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />

    {
      alternateEnUrl && (
        <link rel="alternate" hreflang="en" href={alternateEnUrl} />
      )
    }

    {
      alternatePtUrl && (
        <link rel="alternate" hreflang="pt-PT" href={alternatePtUrl} />
      )
    }

    {
      alternateEnUrl && (
        <link rel="alternate" hreflang="x-default" href={alternateEnUrl} />
      )
    }

    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
