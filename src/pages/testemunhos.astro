---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { testimonials } from "../data/testimonials";

const featuredGoogleReviews = testimonials.slice(0, 3).map((testimonial) => ({
    name: testimonial.name,
    location: testimonial.location,
    text: Array.isArray(testimonial.text)
        ? testimonial.text[0]
        : testimonial.text,
}));
---

<BaseLayout
    title="Testemunhos | ByHenrique"
    description="Testemunhos de clientes sobre experiências de Chef privado, eventos e menus personalizados ByHenrique."
>
    <main>
        <section class="page-section">
            <div class="container">
                <p class="eyebrow">Testemunhos</p>

                <h1>O que dizem os clientes</h1>

                <p class="lead">
                    Algumas palavras de clientes que confiaram no ByHenrique
                    para jantares privados, eventos familiares e experiências
                    gastronómicas à medida.
                </p>

                <section class="google-reviews-section" aria-labelledby="google-reviews-title">
                    <div class="google-reviews-header">
                        <div>
                            <p class="eyebrow">Google reviews</p>
                            <h2 id="google-reviews-title">Opiniões de clientes no Google</h2>
                        </div>

                        <div class="google-reviews-actions">
                            <a
                                class="google-reviews-link secondary"
                                href={site.chefMaisonReviewsUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Ver reviews no Chef Maison
                            </a>
                            <a
                                class="google-reviews-link"
                                href={site.googleReviewsUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Ver no Google
                            </a>
                        </div>
                    </div>

                    <div class="google-review-widget">
                        <iframe
                            title="Google reviews for ByHenrique"
                            src={site.googleReviewsEmbedUrl}
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            allowfullscreen
                        />
                    </div>

                    <div class="google-reviews-grid">
                        {featuredGoogleReviews.map((review) => (
                            <article class="card google-review-card">
                                <div class="google-review-stars" aria-label="Cinco estrelas">★★★★★</div>
                                <p class="google-review-text">“{review.text}”</p>
                                <strong>{review.name}</strong>
                                <span>{review.location}</span>
                            </article>
                        ))}
                    </div>
                </section>

                <div class="testimonials-grid">
                    {
                        testimonials.map((testimonial) => (
                            <article class="card testimonial-card">
                                <div class="testimonial-text">
                                    <span class="quote-mark">“</span>

                                    {Array.isArray(testimonial.text) ? (
                                        testimonial.text.map((paragraph) => (
                                            <p>{paragraph}</p>
                                        ))
                                    ) : (
                                        <p>{testimonial.text}</p>
                                    )}

                                    <span class="quote-mark">”</span>
                                </div>

                                <div>
                                    <strong>{testimonial.name}</strong>
                                    <span>{testimonial.location}</span>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>
</BaseLayout>