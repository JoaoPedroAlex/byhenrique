---
import BaseLayout from "../layouts/BaseLayout.astro";
import { testimonials } from "../data/testimonials";
---

<BaseLayout
    title="Testemunhos | ByHenrique"
    description="Testemunhos de clientes sobre experiências de Chef privado, eventos e menus personalizados ByHenrique."
>
    <main>
        <section class="page-section">
            <div class="container">
                <p class="eyebrow">Testemunhos</p>

                <h1>O que dizem os clientes</h1>

                <p class="lead">
                    Algumas palavras de clientes que confiaram no ByHenrique
                    para jantares privados, eventos familiares e experiências
                    gastronómicas à medida.
                </p>

                <div class="testimonials-grid">
                    {
                        testimonials.map((testimonial) => (
                            <article class="card testimonial-card">
                                <div class="testimonial-text">
                                    <span class="quote-mark">“</span>

                                    {Array.isArray(testimonial.text) ? (
                                        testimonial.text.map((paragraph) => (
                                            <p>{paragraph}</p>
                                        ))
                                    ) : (
                                        <p>{testimonial.text}</p>
                                    )}

                                    <span class="quote-mark">”</span>
                                </div>

                                <div>
                                    <strong>{testimonial.name}</strong>
                                    <span>{testimonial.location}</span>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>
</BaseLayout>