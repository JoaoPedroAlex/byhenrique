---
import ChefPrivadoLocationPage from "../components/ChefPrivadoLocationPage.astro";

export function getStaticPaths() {
  return [
    ["faro", "Faro", "Olhão, Tavira, Loulé, Quinta do Lago e o Sotavento Algarvio"],
    ["quinta-do-lago", "Quinta do Lago", "Vale do Lobo, Almancil, Loulé, Vilamoura e Faro"],
    ["vale-do-lobo", "Vale do Lobo", "Quinta do Lago, Almancil, Loulé, Vilamoura e Faro"],
    ["troia", "Tróia", "Comporta, Grândola, Alcácer do Sal, Setúbal e a costa alentejana"],
    ["comporta", "Comporta", "Tróia, Melides, Grândola, Alcácer do Sal e a costa alentejana"],
    ["tavira", "Tavira", "Faro, Olhão, Cabanas de Tavira, Vila Real de Santo António e o Sotavento Algarvio"],
    ["leiria", "Leiria", "Nazaré, Óbidos, Fátima, Batalha e outras zonas próximas do Centro de Portugal"],
    ["coimbra", "Coimbra", "Lousã, Figueira da Foz, Mealhada, Aveiro e outras zonas próximas do Centro de Portugal"],
    ["grandola", "Grândola", "Comporta, Melides, Tróia, Alcácer do Sal e a costa alentejana"],
    ["alcacer-do-sal", "Alcácer do Sal", "Comporta, Grândola, Tróia, Melides e a costa alentejana"],
    ["sines", "Sines", "Santo André, Porto Covo, Vila Nova de Milfontes, Santiago do Cacém e a costa alentejana"],
    ["santiago-do-cacem", "Santiago do Cacém", "Sines, Santo André, Porto Covo, Vila Nova de Milfontes e a costa alentejana"],
  ].map(([slug, location, areas]) => ({ params: { location: slug }, props: { slug, location, areas } }));
}

const { slug, location, areas } = Astro.props;
const title = `Chef Privado em ${location} | ByHenrique`;
const description = `Chef privado em ${location} para estadias em villas, férias em família, celebrações e retiros, com menus mediterrânicos personalizados e hospitalidade atenta.`;
---

<ChefPrivadoLocationPage
  {location}
  {areas}
  {title}
  {description}
  bookingId={`${slug}-booking-title`}
  alternateEn={`/en/private-chef-${slug}/`}
/>
