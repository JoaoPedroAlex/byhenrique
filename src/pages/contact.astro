---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
---

<BaseLayout
    lang="en"
    title="Contact | ByHenrique"
    description="Contact ByHenrique for private chef, takeaway and personalised event requests."
>
    <main>
        <section class="page-section">
            <div class="container contact-grid">
                <div>
                    <p class="eyebrow">Contact</p>

                    <h1>Shall we talk about your request?</h1>

                    <p class="lead">
                        For private chef requests, private menus or personalised
                        proposals, please use the order form. For other matters,
                        you can contact me by email.
                    </p>

                    <div class="contact-actions">
                        <a class="button" href="/en/order">Fill in the form</a>
                        <a
                            class="button secondary"
                            href={`mailto:${site.email}`}
                        >
                            Send email
                        </a>
                    </div>
                </div>

                <aside class="card contact-card">
                    <h2>Contacts</h2>

                    <p>
                        <strong>Email</strong><br />
                        <a href={`mailto:${site.email}`}>{site.email}</a>
                    </p>

                    {
                        site.instagramUrl && (
                            <p>
                                Instagram:{" "}
                                <a
                                    href={site.instagramUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    @byhenrique
                                </a>
                            </p>
                        )
                    }

                    <p>
                        <strong>Orders and bookings</strong><br />
                        <a href="/en/order">Order form</a>
                    </p>

                    <p>
                        <strong>Service area</strong><br />
                        {site.location}
                    </p>
                </aside>
            </div>
        </section>

        <section class="page-section highlight-section">
            <div class="container">
                <p class="eyebrow">Before contacting</p>

                <h2>Useful information to include in your request.</h2>

                <div class="info-grid">
                    <article class="card">
                        <h3>Date and time</h3>
                        <p>
                            Include the preferred date and, if possible, a time
                            window.
                        </p>
                    </article>

                    <article class="card">
                        <h3>Number of people</h3>
                        <p>
                            Tell me how many people or portions you need for the
                            service or order.
                        </p>
                    </article>

                    <article class="card">
                        <h3>Dietary preferences</h3>
                        <p>
                            Mention allergies, intolerances, restrictions or
                            menu preferences.
                        </p>
                    </article>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
