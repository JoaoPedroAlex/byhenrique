---

<BaseLayout
  lang={lang}
  title={isEn ? "Gallery | ByHenrique" : "Galeria | ByHenrique"}
  description={isEn
    ? "Gallery of dishes and private dining experiences prepared by ByHenrique."
    : "Galeria de pratos, menus e experiências gastronómicas preparadas por ByHenrique."}
>
  <main>
    <section class="page-section">
      <div class="container">
        <p class="eyebrow">{isEn ? "Gallery" : "Galeria"}</p>

        <h1>{isEn ? "Dishes and experiences" : "Pratos, menus e experiências"}</h1>

        <p class="lead">
          {isEn
            ? "A selection of moments, dishes and dining experiences created for private dinners, events and personalised gatherings."
            : "Uma selecção de momentos, pratos e experiências gastronómicas criadas para jantares privados, eventos e menus personalizados."}
        </p>

        <div class="gallery-grid">
          {
            galleryImages.slice().reverse().map((image) => (
              <figure class="gallery-item">
                <img
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                  width="900"
                  height="700"
                />
              </figure>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
