---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrderForm from "../components/OrderForm.astro";
---

<BaseLayout
  title="Encomendar | ByHenrique"
  description="Pede orçamento para Chef em casa, catering ou evento privado."
>
  <main>
    <section class="page-section">
      <div class="container">
        <p class="eyebrow">A tua experiência privada</p>

        <h1>Conta-me o que estás a planear.</h1>

        <p class="lead">
          Não existe um menu fixo para escolher. Partilha a ocasião, a data, o
          local e os convidados, e responderei pessoalmente para criarmos a
          experiência em conjunto.
        </p>

        <OrderForm />
      </div>
    </section>
  </main>
</BaseLayout>
