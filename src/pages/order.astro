---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrderForm from "../../components/OrderForm.astro";
---

<BaseLayout
  lang="en"
  title="Order | ByHenrique"
  description="Request a quote for a private chef service, takeaway order or private event."
>
  <main>
    <section class="page-section">
      <div class="container">
        <p class="eyebrow">Order</p>

        <h1>Request a quote or booking</h1>

        <p class="lead">
          Fill in the form with the details of your request. I will then contact
          you to confirm availability, menu, conditions and final price.
        </p>

        <OrderForm lang="en" />
      </div>
    </section>
  </main>
</BaseLayout>