---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  lang="en"
  title="Private Chef Services in Portugal | ByHenrique"
  description="Private Chef services in Portugal for villa stays, celebrations and retreats, with personalised Mediterranean menus and warm, attentive hospitality."
>
  <main>
    <section class="page-section">
      <div class="container">
        <p class="eyebrow">Services</p>

        <h1>Private Chef Services in Portugal</h1>

        <p class="lead">
          Flexible solutions for meals at home, special dinners, private events
          and carefully prepared Food Delivery orders.
        </p>

        <div class="service-grid">
          <article class="card service-card">
            <h2>Private chef</h2>
            <p>
              A restaurant-style experience in the comfort of your home, with a
              personalised menu, careful preparation and attention to detail.
            </p>

            <ul>
              <li>Private dinners</li>
              <li>Birthdays and special occasions</li>
              <li>Personalised menus</li>
              <li>Options adapted to dietary preferences</li>
            </ul>

            <a class="button" href="/en/book">Request a quote</a>
          </article>

          <article class="card service-card">
            <h2>Food Delivery by order</h2>
            <p>
              Dishes and menus prepared by prior order, ideal for practical
              family meals or special moments at home.
            </p>

            <ul>
              <li>Family-style dishes</li>
              <li>Seasonal menus</li>
              <li>Desserts by order</li>
              <li>Collection or delivery depending on availability</li>
            </ul>

            <a class="button" href="/en/menus">View menus</a>
          </article>

          <article class="card service-card">
            <h2>Private events</h2>
            <p>
              Proposals for small events, family gatherings, private
              celebrations and moments that call for a special meal.
            </p>

            <ul>
              <li>Family events</li>
              <li>Group meals</li>
              <li>Finger food and full menus</li>
              <li>Proposals adapted to the number of guests</li>
            </ul>

            <a class="button" href="/en/contact">Contact me</a>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>