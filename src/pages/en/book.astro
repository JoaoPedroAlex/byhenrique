---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrderForm from "../../components/OrderForm.astro";
---

<BaseLayout
  lang="en"
  title="Book a Private Chef in Portugal | ByHenrique"
  description="Request availability and a personalised proposal for a private chef, villa dinner, celebration or private event in Portugal."
>
  <main>
    <section class="page-section">
      <div class="container">
        <p class="eyebrow">Your private dining experience</p>

        <h1>Tell me what you are planning.</h1>

        <p class="lead">
          There is no fixed menu to choose from. Share your occasion, preferred
          date, location and guests, and I will personally reply to shape the
          experience with you.
        </p>

        <OrderForm lang="en" />
      </div>
    </section>
  </main>
</BaseLayout>
