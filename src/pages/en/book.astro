---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrderForm from "../../components/OrderForm.astro";
---

<BaseLayout
  lang="en"
  title="Book a Private Chef in Portugal | ByHenrique"
  description="Request availability and a personalised proposal for a private chef, villa dinner, celebration or private event in Portugal."
>
  <main>
    <section class="page-section">
      <div class="container">
        <p class="eyebrow">Booking enquiry</p>

        <h1>Book a private chef in Portugal</h1>

        <p class="lead">
          Share your preferred date, location, number of guests and ideas. I
          will reply to confirm availability and prepare a personalised
          proposal.
        </p>

        <OrderForm lang="en" />
      </div>
    </section>
  </main>
</BaseLayout>