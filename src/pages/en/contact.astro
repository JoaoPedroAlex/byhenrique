---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
---

<BaseLayout
    lang="en"
    title="Contact | ByHenrique"
    description="Contact ByHenrique for private chef, catering and personalised event requests."
>
    <main>
        <section class="page-section">
            <div class="container contact-grid">
                <div>
                    <p class="eyebrow">Contact</p>

                    <h1>Shall we talk about your request?</h1>

                    <p class="lead">
                        For private chef requests, private menus or personalised
                        proposals, please use the order form. For other matters,
                        you can contact me by email.
                    </p>

                    <div class="contact-actions">
                        <a class="button" href="/en/book">Fill in the form</a>
                        <a
                            class="button secondary"
                            href={`mailto:${site.email}`}
                        >
                            Send email
                        </a>
                    </div>
                </div>

                <aside class="card contact-card">
                    <h2>Contacts</h2>

                    <p>
                        <strong>Email</strong><br />
                        <a href={`mailto:${site.email}`}>{site.email}</a>
                    </p>

                    {
                        site.instagramUrl && (
                            <p>
                                Instagram:{" "}
                                <a
                                    href={site.instagramUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    @byhenrique
                                </a>
                            </p>
                        )
                    }

                    <p>
                        <strong>Bookings</strong><br />
                        <a href="/en/book">Booking form</a>
                    </p>

                    <p>
                        <strong>Service area</strong><br />
                        {site.location}
                    </p>
                </aside>
            </div>
        </section>

    </main>
</BaseLayout>
