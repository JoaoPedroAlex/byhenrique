---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { testimonials } from "../../data/testimonials";
---

<BaseLayout
    lang="en"
    title="Private Chef Reviews in Portugal"
    description="Read reviews from guests who booked ByHenrique for private dinners, holidays, family celebrations, weddings and special events in Portugal."
>
    <main>
        <section class="page-section">
            <div class="container">
                <p class="eyebrow">Testimonials</p>

                <h1>What guests say about ByHenrique</h1>

                <p class="lead">
                    Experiences shared by guests who chose ByHenrique for
                    private dinners, family celebrations, holidays, weddings
                    and memorable moments around the table.
                </p>

                <div class="testimonials-grid">
                    {
                        testimonials.map((testimonial) => (
                            <article class="card testimonial-card">
                                <div class="testimonial-text">
                                    <span class="quote-mark">“</span>

                                    {Array.isArray(testimonial.text) ? (
                                        testimonial.text.map((paragraph) => (
                                            <p>{paragraph}</p>
                                        ))
                                    ) : (
                                        <p>{testimonial.text}</p>
                                    )}

                                    <span class="quote-mark">”</span>
                                </div>

                                <div>
                                    <strong>{testimonial.name}</strong>
                                    <span>{testimonial.location}</span>
                                </div>
                            </article>
                        ))
                    }
                </div>

                <section
                    class="booking-cta"
                    aria-labelledby="booking-cta-title"
                >
                    <p class="eyebrow">Your experience</p>

                    <h2 id="booking-cta-title">
                        Planning a private dinner or celebration in Portugal?
                    </h2>

                    <p>
                        Tell me your preferred date, location, number of guests
                        and ideas. I will reply with availability and a
                        personalised proposal.
                    </p>

                    <a class="booking-cta-link" href="/en/order/">
                        Request a quote
                    </a>
                </section>
            </div>
        </section>
    </main>
</BaseLayout>