---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  lang="en"
  title="ByHenrique | Private chef Cateringand takeaway"
  description="Private chef services, personalised menus, Catering and takeaway orders for dinners, events and special moments."
>
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow">Private chef · Catering · Takeaway · Events</p>

          <h1>Tailored cooking experiences at your home.</h1>

          <p class="lead">
            ByHenrique brings personalised menus, private chef services and
            takeaway orders to special moments, private dinners and family
            events.
          </p>

          <div class="hero-actions">
            <a class="button" href="/en/menus">View menus</a>
            <a class="button secondary" href="/en/order">Request a quote</a>
          </div>
        </div>

        <div class="hero-visual">
          <img
            src="/images/hummus.jpg"
            alt="Experiência de Chef privado ByHenrique"
            class="hero-visual-image"
            width="1200"
            height="900"
        />

        <div class="hero-visual">
          <div class="hero-visual-content">
            <p>ByHenrique</p>
            <h2>Private chef & Catering & takeaway</h2>
            <span>Personalised menus for special moments</span>
          </div>
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="container">
        <p class="eyebrow">How it works</p>

        <h2>A simple process, from request to table.</h2>

        <div class="steps-grid">
          <article class="card">
            <span class="step-number">1</span>
            <h3>Choose the service</h3>
            <p>
              Tell me whether you need a private chef, takeaway, a private event
              or a customised proposal.
            </p>
          </article>

          <article class="card">
            <span class="step-number">2</span>
            <h3>Define the menu</h3>
            <p>
              We adjust the menu to the number of guests, occasion, preferences
              and dietary restrictions.
            </p>
          </article>

          <article class="card">
            <span class="step-number">3</span>
            <h3>Confirm the details</h3>
            <p>
              I confirm availability, conditions, time, location and final price
              before the booking is closed.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="container">
        <p class="eyebrow">Where I am available</p>

        <h2>Private chef available in several regions of Portugal.</h2>

        <p class="lead">
          Private chef service available in the Algarve, Alentejo, Greater
          Lisbon and the Center of Portugal, including
          Faro, Albufeira, Vilamoura, Quinta do Lago, Vale do Lobo, Portimão,
          Lagos, Tavira, Tróia, Comporta, Grândola, Alcácer do Sal, Sines,
          Santiago do Cacém, Leiria and Coimbra.
        </p>

      </div>
    </section>
    
    <section class="page-section highlight-section">
      <div class="container highlight-grid">
        <div>
          <p class="eyebrow">Menus</p>
          <h2>Menus for different occasions.</h2>
          <p class="lead">
            From traditional options to lighter or fully customised menus, each
            request can be adapted to the occasion, season and guests’
            preferences.
          </p>

           <img
            src="/images/OChefe.jpg"
            alt="O Chefe Henrique"
            class="section-image"
            loading="lazy"
            width="1200"
            height="800"
          />
        </div>

        <div class="card">
          <h3>Need a tailored proposal?</h3>
          <p>
            Send the details of your request and receive a menu suggestion,
            availability confirmation and quote.
          </p>
          <a class="button" href="/en/order">Send request</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>