---
import type { MenuItem } from "../data/menus";

type Props = {
  menu: MenuItem;
  lang?: "pt" | "en";
};

const { menu, lang = "pt" } = Astro.props;

const content = lang === "en" ? menu.en : menu.pt;

const categoryLabel =
  menu.category === "chef-em-casa"
    ? lang === "en"
      ? "Private chef"
      : "Chef em casa"
    : menu.category === "take-away"
      ? lang === "en"
        ? "Takeaway"
        : "Take away"
      : lang === "en"
        ? "Event"
        : "Evento";

const orderLabel = lang === "en" ? "Order this menu" : "Encomendar este menu";
const minimumLabel = lang === "en" ? "Minimum" : "Mínimo";
const peopleLabel = lang === "en" ? "people" : "pessoas";
const orderPath = lang === "en" ? "/en/order" : "/encomendar";
---

<article class="card menu-card">
  <div class="menu-image-placeholder">
    <span>{content.name}</span>
  </div>

  <div>
    <p class="menu-category">{categoryLabel}</p>

    <h2>{content.name}</h2>

    <p>{content.description}</p>
  </div>

  <ul>
    {content.dishes.map((dish) => <li>{dish}</li>)}
  </ul>

  <div class="menu-footer">
    <strong>{content.priceLabel}</strong>

    {
      menu.minPeople && (
        <span>{minimumLabel}: {menu.minPeople} {peopleLabel}</span>
      )
    }
  </div>

  {
    content.allergens && (
      <p class="allergens">{content.allergens}</p>
    )
  }

  <a class="button" href={`${orderPath}?menu=${menu.id}`}>
    {orderLabel}
  </a>
</article>