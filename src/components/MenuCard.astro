---
import type { MenuItem } from "../data/menus";

type Props = {
  menu: MenuItem;
  lang?: "pt" | "en";
};

const { menu, lang = "pt" } = Astro.props;

const content = lang === "en" ? menu.en : menu.pt;

const orderLabel = lang === "en" ? "Order this menu" : "Encomendar este menu";
const orderPath = lang === "en" ? "/en/order" : "/encomendar";
const experienceTitle = lang === "en" ? "Menu experience" : "Experiência do menu";
---

<article class="card menu-card menu-experience-card">
  <div class="menu-image-placeholder">
    <span>{content.name}</span>
  </div>

  <div>
    <p class="menu-category">ByHenrique Experience</p>
    <h2>{content.name}</h2>
    <p class="menu-subtitle">{content.subtitle}</p>
    <p>{content.description}</p>
  </div>

  <div class="menu-section">
    <h3>{content.startersTitle}</h3>

    <div class="menu-items">
      {
        content.starters.map((item) => (
          <div class="menu-item">
            <strong>{item.name}</strong>
            <p>{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="menu-section">
    <h3>{content.mainTitle}</h3>

    <div class="menu-item">
      <strong>{content.main.name}</strong>
      <p>{content.main.description}</p>
    </div>
  </div>

  <div class="menu-section">
    <h3>{content.dessertTitle}</h3>

    <div class="menu-item">
      <strong>{content.dessert.name}</strong>
      <p>{content.dessert.description}</p>
    </div>
  </div>

  <div class="menu-experience-box">
    <h3>{experienceTitle}</h3>
    <ul>
      {content.experience.map((line) => <li>{line}</li>)}
    </ul>
  </div>

  <a class="button" href={`${orderPath}?menu=${menu.id}`}>
    {orderLabel}
  </a>
</article>