---
import { site } from "../data/site";

const { lang = "pt" } = Astro.props;

const isEn = lang === "en";
const contactLabel = isEn ? "Contact" : "Contactos";
const emailLabel = isEn ? "Email" : "Email";
const ordersLabel = isEn ? "Booking" : "Pedidos";
const formLabel = isEn ? "Fill in the form" : "Preencher formulário";
const galleryLabel = isEn ? "Gallery" : "Galeria";
const infoLabel = isEn ? "Information" : "Informação";
const privacyLabel = isEn ? "Privacy policy" : "Política de privacidade";
const termsLabel = isEn ? "Order conditions" : "Condições de encomenda";
const contactPage = isEn ? "/en/contact" : "/contacto";
const orderPage = isEn ? "/en/book" : "/encomendar";
const privacyPage = "/politica-privacidade";
const termsPage = "/condicoes";
const galleryPage = "/galeria";
const copyrightText = isEn ? "All rights reserved." : "Todos os direitos reservados.";
const descriptionLine1 = isEn
  ? "Private chef, personalised menus and customised Food Delivery orders."
  : "Chef privado, menus personalizados e Food Delivery por encomenda.";
const descriptionLine2 = isEn
  ? "Available in the Algarve, Alentejo, Greater Lisbon and Central Portugal."
  : "Disponível no Algarve, Alentejo, Grande Lisboa e Centro de Portugal.";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h2>{site.name}</h2>
      <p>{descriptionLine1}</p>
      <p>{descriptionLine2}</p>
    </div>

    <div>
      <h3>{contactLabel}</h3>
      <p>{emailLabel}: <a href={`mailto:${site.email}`}>{site.email}</a></p>
      {
        site.instagramUrl && (
          <p>
            Instagram:{" "}
            <a
              href={site.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              @byhenrique
            </a>
          </p>
        )
      }
      <p>{ordersLabel}: <a href={orderPage}>{formLabel}</a></p>
      <p><a href={galleryPage}>{galleryLabel}</a></p>
    </div>

    <div>
      <h3>{infoLabel}</h3>
      <p><a href={privacyPage}>{privacyLabel}</a></p>
      <p><a href={termsPage}>{termsLabel}</a></p>
      <p><a href={contactPage}>{isEn ? "Contact" : "Contacto"}</a></p>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© 2026 {site.name}. {copyrightText}</p>
  </div>
</footer>
