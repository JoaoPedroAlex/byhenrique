---
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h2>{site.name}</h2>
      <p>Chef privado, menus personalizados e Food Delivery por encomenda.</p>
      <p>Disponível no Algarve, Alentejo, Grande Lisboa e Centro de Portugal.</p>
    </div>

    <div>
      <h3>Contactos</h3>
      <p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
      {
        site.instagramUrl && (
          <p>
            Instagram:{" "}
            <a
              href={site.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              @byhenrique
            </a>
          </p>
        )
      }
      <p>Pedidos: <a href="/encomendar">Preencher formulário</a></p>
      <p><a href="/galeria">Galeria</a></p>
    </div>

    <div>
      <h3>Informação</h3>
      <p><a href="/politica-privacidade">Política de privacidade</a></p>
      <p><a href="/condicoes">Condições de encomenda</a></p>
      <p><a href="/contacto">Contacto</a></p>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© 2026 {site.name}. Todos os direitos reservados.</p>
  </div>
</footer>
