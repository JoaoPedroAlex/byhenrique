---
type Props = {
  lang?: "pt" | "en";
};

const { lang = "pt" } = Astro.props;

const isEn = lang === "en";
---

<form class="order-form" method="POST" action="https://formspree.io/f/xjglplld">
  <div class="form-grid">
    <label>
      {isEn ? "Name" : "Nome"}
      <input type="text" name="nome" required />
    </label>

    <label>
      Email
      <input type="email" name="email" required />
    </label>

    <label>
      {isEn ? "Phone" : "Telefone"}
      <input type="tel" name="telefone" required />
    </label>

    <label>
      {isEn ? "Request type" : "Tipo de pedido"}
      <select name="tipo_pedido" id="tipo_pedido" required>
        <option value="">{isEn ? "Select..." : "Selecionar..."}</option>
        <option value="chef-em-casa"
          >{isEn ? "Private chef" : "Chef em casa"}</option
        >
        <option value="take-away">{isEn ? "Takeaway" : "Take away"}</option>
        <option value="evento"
          >{isEn ? "Private event" : "Evento privado"}</option
        >
        <option value="outro">{isEn ? "Other" : "Outro"}</option>
      </select>
    </label>

    <label>
      {isEn ? "Preferred date" : "Data pretendida"}
      <input type="date" name="data" required />
    </label>

    <label>
      {isEn ? "Preferred time" : "Hora pretendida"}
      <input type="time" name="hora" />
    </label>

    <label>
      {isEn ? "Number of guests or portions" : "Número de pessoas ou doses"}
      <input type="number" name="quantidade" min="1" required />
    </label>

    <div class="menu-field" id="menu-field">
      <label>
        {isEn ? "Preferred menu" : "Menu pretendido"}
        <select name="menu" id="menu">
          <option value="">
            {isEn ? "Select a menu..." : "Selecionar menu..."}
          </option>
          <option value="Laventenian Menu">Laventenian Menu</option>
          <option value="Athena’s Table">Athena’s Table</option>
          <option value="Fado Menu">Fado Menu</option>
          <option value="custom">
            {isEn ? "Custom proposal" : "Proposta personalizada"}
          </option>
        </select>
      </label>
    </div>
  </div>

  <div class="selected-menu-note" id="selected-menu-note" hidden></div>

  <label>
    {isEn ? "Location / area" : "Localidade / zona"}
    <input type="text" name="localidade" />
  </label>

  <label>
    {
      isEn
        ? "Allergies or food intolerances"
        : "Alergias ou intolerâncias alimentares"
    }
    <textarea name="alergias" rows="3"></textarea>
  </label>

  <label>
    {isEn ? "Message" : "Mensagem"}
    <textarea
      name="mensagem"
      rows="5"
      required
      placeholder={isEn
        ? "Tell me what you need: occasion, number of guests, type of menu, approximate location, dietary restrictions, etc."
        : "Conta-me o que pretendes: ocasião, número de pessoas, tipo de menu, morada aproximada, restrições alimentares, etc."}
    ></textarea>
  </label>

  <label class="checkbox">
    <input type="checkbox" name="consentimento" required />
    <span>
      {
        isEn
          ? "I agree that my data may be used to respond to this request."
          : "Aceito que os meus dados sejam usados para resposta a este pedido."
      }
    </span>
  </label>

  <button type="submit">{isEn ? "Send request" : "Enviar pedido"}</button>

  <p class="form-note">
    {
      isEn
        ? "Submitting this form does not automatically confirm the booking. I will contact you to confirm availability, details and final price."
        : "O envio do formulário não confirma automaticamente a reserva. Entrarei em contacto para confirmar disponibilidade, detalhes e valor final."
    }
  </p>
</form>

<script define:vars={{ isEn }}>
  const menus = {
    laventenian: {
      name: "Laventenian Menu",
      category: "chef-em-casa",
    },
    "athenas-table": {
      name: "Athena’s Table",
      category: "chef-em-casa",
    },
    fado: {
      name: "Fado Menu",
      category: "chef-em-casa",
    },
  };

  const params = new URLSearchParams(window.location.search);
  const selectedMenuId = params.get("menu");

  const menuField = document.querySelector("#menu-field");
  const tipoPedidoSelect = document.querySelector("#tipo_pedido");

  function updateMenuFieldVisibility() {
    if (!menuField || !tipoPedidoSelect) return;

    const shouldShowMenuField = tipoPedidoSelect.value === "chef-em-casa";

    menuField.hidden = !shouldShowMenuField;
  }

  if (tipoPedidoSelect) {
    tipoPedidoSelect.addEventListener("change", updateMenuFieldVisibility);
  }

  if (selectedMenuId && menus[selectedMenuId]) {
    const selectedMenu = menus[selectedMenuId];

    const menuInput = document.querySelector("#menu");
    const selectedMenuNote = document.querySelector("#selected-menu-note");

    if (menuInput) {
      menuInput.value = selectedMenu.name;
    }

    if (tipoPedidoSelect) {
      tipoPedidoSelect.value = selectedMenu.category;
    }

    if (selectedMenuNote) {
      selectedMenuNote.hidden = false;
      selectedMenuNote.innerHTML = `<strong>${isEn ? "Selected menu" : "Menu selecionado"}:</strong> ${selectedMenu.name}`;
    }
  }

  updateMenuFieldVisibility();
</script>
