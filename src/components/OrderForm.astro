<form class="order-form" method="POST" action="">
  <div class="form-grid">
    <label>
      Nome
      <input type="text" name="nome" required />
    </label>

    <label>
      Email
      <input type="email" name="email" required />
    </label>

    <label>
      Telefone
      <input type="tel" name="telefone" required />
    </label>

    <label>
      Tipo de pedido
      <select name="tipo_pedido" id="tipo_pedido" required>
        <option value="">Selecionar...</option>
        <option value="chef-em-casa">Chef em casa</option>
        <option value="take-away">Take away</option>
        <option value="evento">Evento privado</option>
        <option value="outro">Outro</option>
      </select>
    </label>

    <label>
      Data pretendida
      <input type="date" name="data" required />
    </label>

    <label>
      Hora pretendida
      <input type="time" name="hora" />
    </label>

    <label>
      Número de pessoas ou doses
      <input type="number" name="quantidade" min="1" required />
    </label>

    <label>
      Menu pretendido
      <input
        type="text"
        name="menu"
        id="menu"
        placeholder="Ex.: Menu Tradicional"
      />
    </label>
  </div>

  <div class="selected-menu-note" id="selected-menu-note" hidden></div>

  <label>
    Localidade / zona
    <input type="text" name="localidade" />
  </label>

  <label>
    Alergias ou intolerâncias alimentares
    <textarea name="alergias" rows="3"></textarea>
  </label>

  <label>
    Mensagem
    <textarea
      name="mensagem"
      rows="5"
      required
      placeholder="Conta-me o que pretendes: ocasião, número de pessoas, tipo de menu, morada aproximada, restrições alimentares, etc."
    ></textarea>
  </label>

  <label class="checkbox">
    <input type="checkbox" name="consentimento" required />
    <span>
      Aceito que os meus dados sejam usados para resposta a este pedido.
    </span>
  </label>

  <button type="submit">Enviar pedido</button>

  <p class="form-note">
    O envio do formulário não confirma automaticamente a reserva. Entrarei em contacto para confirmar disponibilidade, detalhes e valor final.
  </p>
</form>

<script>
  const menus = {
    tradicional: {
      name: "Menu Tradicional",
      category: "chef-em-casa",
    },
    mediterranico: {
      name: "Menu Mediterrânico",
      category: "chef-em-casa",
    },
    "take-away-familiar": {
      name: "Take Away Familiar",
      category: "take-away",
    },
  };

  const params = new URLSearchParams(window.location.search);
  const selectedMenuId = params.get("menu");

  if (selectedMenuId && menus[selectedMenuId]) {
    const selectedMenu = menus[selectedMenuId];

    const menuInput = document.querySelector("#menu");
    const tipoPedidoSelect = document.querySelector("#tipo_pedido");
    const selectedMenuNote = document.querySelector("#selected-menu-note");

    if (menuInput) {
      menuInput.value = selectedMenu.name;
    }

    if (tipoPedidoSelect) {
      tipoPedidoSelect.value = selectedMenu.category;
    }

    if (selectedMenuNote) {
      selectedMenuNote.hidden = false;
      selectedMenuNote.innerHTML = `<strong>Menu selecionado:</strong> ${selectedMenu.name}`;
    }
  }
</script>