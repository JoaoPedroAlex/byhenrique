---
type Props = {
  lang?: "pt" | "en";
};

const { lang = "pt" } = Astro.props;

const isEn = lang === "en";
---

<form class="order-form" method="POST" action="https://formspree.io/f/xjglplld">
  <input type="hidden" name="_subject" value={isEn ? "New ByHenrique experience enquiry" : "Novo pedido de experiência ByHenrique"} />

  <div class="form-intro-note">
    <strong>{isEn ? "A personal process from the first message" : "Um processo pessoal desde a primeira mensagem"}</strong>
    <span>{isEn ? "Tell me what matters most. We will discuss the menu privately after I understand your occasion." : "Conta-me o que é mais importante. Conversaremos sobre o menu em privado depois de conhecer a ocasião."}</span>
  </div>

  <label>
    {isEn ? "What are you celebrating or planning?" : "O que estás a celebrar ou planear?"}
    <select name="ocasiao" required>
      <option value="">{isEn ? "Select an occasion" : "Seleciona uma ocasião"}</option>
      <option value="private-dinner">{isEn ? "Private dinner" : "Jantar privado"}</option>
      <option value="birthday">{isEn ? "Birthday" : "Aniversário"}</option>
      <option value="family-gathering">{isEn ? "Family gathering" : "Encontro de família"}</option>
      <option value="wedding">{isEn ? "Wedding or intimate celebration" : "Casamento ou celebração intimista"}</option>
      <option value="holiday">{isEn ? "Holiday or villa stay" : "Férias ou estadia em villa"}</option>
      <option value="other">{isEn ? "Something else" : "Outra ocasião"}</option>
    </select>
  </label>

  <div class="form-grid">
    <label>
      {isEn ? "Name" : "Nome"}
      <input type="text" name="nome" required />
    </label>

    <label>
      Email
      <input type="email" name="email" required />
    </label>

    <label>
      {isEn ? "Phone" : "Telefone"}
      <input type="tel" name="telefone" required />
    </label>

    <label>
      {isEn ? "Preferred date" : "Data pretendida"}
      <input type="date" name="data" required />
    </label>

    <label>
      {isEn ? "Preferred time" : "Hora pretendida"}
      <input type="time" name="hora" />
    </label>

    <label>
      {isEn ? "Number of guests or portions" : "Número de pessoas ou doses"}
      <input type="number" name="quantidade" min="1" required />
    </label>

  </div>

  <label>
    {isEn ? "Event location" : "Localidade / zona"}
    <input type="text" name="localidade" />
  </label>

  <label>
    {
      isEn
        ? "Food preferences, allergies or intolerances"
        : "Preferências, alergias ou intolerâncias alimentares"
    }
    <textarea name="alergias" rows="3"></textarea>
  </label>

  <label>
    {isEn ? "Message" : "Mensagem"}
    <textarea
      name="mensagem"
      rows="5"
      required
      placeholder={isEn
        ? "Tell me how you would like the evening to feel, what matters to your guests, and any ideas you already have."
        : "Conta-me como gostarias que a ocasião fosse sentida, o que é importante para os convidados e as ideias que já tens."}
    ></textarea>
  </label>

  <label class="checkbox">
    <input type="checkbox" name="consentimento" required />
    <span>
      {
        isEn
          ? "I agree that my data may be used to respond to this request."
          : "Aceito que os meus dados sejam usados para resposta a este pedido."
      }
    </span>
  </label>

  <button type="submit">{isEn ? "Send my enquiry" : "Enviar o meu pedido"}</button>

  <p class="form-note">
    {
      isEn
        ? "No commitment. I will personally reply to confirm availability and discuss your experience, menu and final proposal."
        : "Sem compromisso. Responderei pessoalmente para confirmar a disponibilidade e conversar sobre a experiência, o menu e a proposta final."
    }
  </p>
</form>
