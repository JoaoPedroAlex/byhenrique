---
import { languages } from "../data/i18n";

const { lang = "pt" } = Astro.props;

const currentLang = lang === "en" ? languages.en : languages.pt;
const otherLang = lang === "en" ? languages.pt : languages.en;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={currentLang.home}>ByHenrique</a>

    <nav class="nav" aria-label={lang === "en" ? "Main navigation" : "Navegação principal"}>
      <a href={currentLang.services}>{lang === "en" ? "Services" : "Serviços"}</a>
      <a href={currentLang.menus}>{lang === "en" ? "Menus" : "Menus"}</a>
      <a href={currentLang.order}>{lang === "en" ? "Order" : "Encomendar"}</a>
      <a href={currentLang.about}>{lang === "en" ? "About" : "Sobre"}</a>
      <a href={currentLang.contact}>{lang === "en" ? "Contact" : "Contacto"}</a>
      <a href={currentLang.testimonials}>{lang === "en" ? "Testimonials" : "Testemunhos"}</a>
      <a href={currentLang.gallery}>{lang === "en" ? "Gallery" : "Galeria"}</a>
      <a class="language-link" href={otherLang.home}>{otherLang.shortLabel}</a>
    </nav>
  </div>
</header>