---
type Props = { lang?: "pt" | "en" };
const { lang = "pt" } = Astro.props;
const isEn = lang === "en";
const links = isEn
  ? { book: "/en/book", services: "/en/services", about: "/en/about", testimonials: "/en/testimonials", gallery: "/en/gallery" }
  : { book: "/encomendar", services: "/servicos", about: "/sobre", testimonials: "/testemunhos", gallery: "/galeria" };
const steps = isEn
  ? [
      ["01", "Tell me about your occasion", "Share the date, location, number of guests and the kind of evening you have in mind."],
      ["02", "We shape it together", "I learn about your tastes, dietary needs and the atmosphere you want to create."],
      ["03", "I create your proposal", "Your menu and experience are developed personally, with every detail considered."],
      ["04", "You enjoy the table", "I shop, prepare, cook, serve the dishes and leave the kitchen clean."],
    ]
  : [
      ["01", "Conta-me sobre a ocasião", "Partilha a data, o local, o número de convidados e o tipo de momento que imaginas."],
      ["02", "Criamos a ideia em conjunto", "Conversamos sobre gostos, necessidades alimentares e o ambiente que queres criar."],
      ["03", "Preparo a tua proposta", "O menu e a experiência são criados pessoalmente, com atenção a cada detalhe."],
      ["04", "Tu desfrutas da mesa", "Trato das compras, preparação, cozinha, apresentação e deixo a cozinha limpa."],
    ];
---

<main class="experience-home">
  <section class="experience-hero">
    <div class="container experience-hero-grid">
      <div class="experience-hero-copy">
        <p class="eyebrow">{isEn ? "Private chef in Portugal" : "Chef privado em Portugal"}</p>
        <h1>
          {isEn ? "Private dining with the soul of the " : "Experiências privadas com a alma do "}
          <em>{isEn ? "Mediterranean." : "Mediterrâneo."}</em>
        </h1>
        <p class="experience-intro">
          {isEn
            ? "Personalised dining shaped by Portugal, Greece, Spain and the Levant—created for your guests, your occasion and your table."
            : "Uma experiência gastronómica inspirada em Portugal, Grécia, Espanha e Levante—criada para os teus convidados, a tua ocasião e a tua mesa."}
        </p>
        <div class="hero-actions">
          <a class="button" href={links.book}>{isEn ? "Check availability" : "Verificar disponibilidade"}</a>
          <a class="text-link" href="#experience">{isEn ? "Discover the experience" : "Descobrir a experiência"} <span aria-hidden="true">↘</span></a>
        </div>
        <p class="hero-locations">
          Algarve <span>·</span> Alentejo <span>·</span> {isEn ? "Greater Lisbon" : "Grande Lisboa"} <span>·</span> {isEn ? "Central Portugal" : "Centro de Portugal"}
        </p>
      </div>

      <div class="experience-hero-media">
        <div class="hero-main-image">
          <img src="/images/IMG_4293.jpg" alt={isEn ? "Roasted aubergines with pomegranate and herbs" : "Beringelas assadas com romã e ervas"} width="985" height="1600" fetchpriority="high" />
        </div>
        <figure class="hero-food-card">
          <img src="/images/IMG_8164.jpeg" alt={isEn ? "A celebration cake served at a private dinner" : "Bolo de celebração servido num jantar privado"} width="1206" height="1844" />
        </figure>
        <p class="hero-signature">Four Shores.<br />One Table.</p>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label={isEn ? "Service highlights" : "Destaques do serviço"}>
    <div class="container trust-grid">
      <p><strong>{isEn ? "Personally created" : "Criado pessoalmente"}</strong><span>{isEn ? "Every experience is unique" : "Cada experiência é única"}</span></p>
      <p><strong>{isEn ? "Complete service" : "Serviço completo"}</strong><span>{isEn ? "From planning to a clean kitchen" : "Do planeamento à cozinha limpa"}</span></p>
      <p><strong>{isEn ? "Warm hospitality" : "Hospitalidade genuína"}</strong><span>{isEn ? "Relaxed, generous and personal" : "Descontraída, generosa e pessoal"}</span></p>
    </div>
  </section>

  <section class="experience-section" id="experience">
    <div class="container experience-heading-grid">
      <div>
        <p class="eyebrow">{isEn ? "The experience" : "A experiência"}</p>
        <h2>{isEn ? "More than dinner. A table with its own story." : "Mais do que um jantar. Uma mesa com a sua própria história."}</h2>
      </div>
      <div class="section-copy">
        <p>{isEn ? "There is no fixed menu to choose from. I first listen: who is coming, what you love, what you are celebrating and how you want the evening to feel." : "Não existe um menu fixo para escolher. Primeiro escuto: quem estará presente, o que gostam, o que celebram e como querem que a noite seja sentida."}</p>
        <p>{isEn ? "From there, I create a personal proposal that brings flavour, culture and generous Mediterranean hospitality to your table." : "A partir daí, crio uma proposta pessoal que leva sabor, cultura e a generosidade mediterrânica à tua mesa."}</p>
        <a class="text-link" href={links.services}>{isEn ? "What the service includes" : "O que o serviço inclui"} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="container experience-steps">
      {steps.map(([number, title, text]) => (
        <article class="experience-step"><span>{number}</span><h3>{title}</h3><p>{text}</p></article>
      ))}
    </div>
  </section>

  <section class="four-shores-section">
    <div class="container four-shores-grid">
      <div class="four-shores-image">
        <img src="/images/logo.png" alt={isEn ? "Four Shores, One Table: Greece, the Levant, Spain and Portugal" : "Four Shores, One Table: Grécia, Levante, Espanha e Portugal"} width="1659" height="948" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">Four Shores · One Table</p>
        <h2>{isEn ? "Four cultures. One generous way of welcoming people." : "Quatro culturas. Uma forma generosa de receber."}</h2>
        <p>{isEn ? "With roots in the Levant and a heart that belongs to Portugal, my cooking moves freely between the culinary cultures of Portugal, Greece, Spain and the Levant." : "Com raízes no Levante e o coração ligado a Portugal, a minha cozinha cruza livremente as culturas culinárias de Portugal, Grécia, Espanha e Levante."}</p>
        <p>{isEn ? "The result is colourful, abundant food served with stories, warmth and enough space for your evening to unfold naturally." : "O resultado é uma cozinha colorida e abundante, servida com histórias, proximidade e espaço para a noite acontecer naturalmente."}</p>
        <a class="text-link light" href={links.about}>{isEn ? "Meet Henrique" : "Conhecer o Henrique"} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="experience-section moments-section">
    <div class="container section-heading-row">
      <div><p class="eyebrow">{isEn ? "Around the table" : "À volta da mesa"}</p><h2>{isEn ? "Colour, character and a sense of occasion." : "Cor, personalidade e sentido de ocasião."}</h2></div>
      <a class="text-link" href={links.gallery}>{isEn ? "View the gallery" : "Ver a galeria"} <span aria-hidden="true">→</span></a>
    </div>
    <div class="container moments-grid">
      <figure class="moment moment-tall"><img src="/images/IMG_8137.jpeg" alt={isEn ? "Mediterranean pasta served at a private dinner" : "Massa mediterrânica servida num jantar privado"} width="1206" height="1175" loading="lazy" /></figure>
      <figure class="moment"><img src="/images/IMG_4685.jpg" alt={isEn ? "A celebratory dessert inspired by the Levant" : "Sobremesa de celebração inspirada no Levante"} width="1022" height="1158" loading="lazy" /></figure>
      <figure class="moment"><img src="/images/IMG_4024_Original.jpg" alt={isEn ? "A carefully plated Mediterranean dish" : "Prato mediterrânico apresentado com cuidado"} width="900" height="1600" loading="lazy" /></figure>
    </div>
  </section>

  <section class="testimonial-feature">
    <div class="container testimonial-feature-inner">
      <p class="eyebrow">{isEn ? "Guest experience" : "Experiência dos convidados"}</p>
      <blockquote>{isEn ? "“Many chefs can cook well. Very few can create an experience. Henrique does both brilliantly.”" : "“Muitos chefs cozinham bem. Muito poucos conseguem criar uma experiência. O Henrique faz ambas as coisas de forma brilhante.”"}</blockquote>
      <p class="testimonial-attribution">João Pedro · Portugal</p>
      <a class="text-link" href={links.testimonials}>{isEn ? "Read guest stories" : "Ler histórias dos convidados"} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="final-cta-section">
    <div class="container final-cta">
      <p class="eyebrow">{isEn ? "Your table" : "A tua mesa"}</p>
      <h2>{isEn ? "Tell me what you are planning." : "Conta-me o que estás a planear."}</h2>
      <p>{isEn ? "Share your date, location, guests and ideas. I will personally reply with availability and the next steps for creating your experience." : "Partilha a data, o local, os convidados e as tuas ideias. Responderei pessoalmente com a disponibilidade e os próximos passos."}</p>
      <a class="button" href={links.book}>{isEn ? "Check availability" : "Verificar disponibilidade"}</a>
      <span>{isEn ? "No commitment · Personal reply" : "Sem compromisso · Resposta pessoal"}</span>
    </div>
  </section>
</main>
